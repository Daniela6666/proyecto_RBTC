<?xml version="1.0"?>
<!-- Robot unico de dif_bot: geometria y sensores del robot de persona-b (urdf/robot.urdf original).
     Argumentos:
       use_ros2_control:=false (defecto) -> DiffDrive nativo de Gazebo + JointStatePublisher (gz_control.xacro)
       use_ros2_control:=true            -> hardware ign_ros2_control (ros2_control.xacro)
       use_ekf:=false (defecto)          -> la odometria de rueda publica odom->base_link
       use_ekf:=true                     -> lo publica el EKF; la odometria no publica ese TF -->
<robot name="dif_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_ros2_control" default="false"/>
  <xacro:arg name="use_ekf" default="false"/>

  <!-- ===================== Cuerpo ===================== -->
  <link name="base_link">
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.06" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.3 0.15"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.3 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================== Ruedas motrices ===================== -->
  <!-- Cilindro r=0.1, longitud 0.05, masa 0.3. Eje Y. y=+-0.19 (separacion 0.38), z=-0.05 -->
  <xacro:macro name="wheel" params="side ypos">
    <link name="${side}_wheel">
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <origin rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${ypos} -0.05"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left" ypos="0.19"/>
  <xacro:wheel side="right" ypos="-0.19"/>

  <!-- ===================== Ruedas locas (sin friccion) ===================== -->
  <link name="front_caster">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.16 0 -0.115"/>
  </joint>

  <gazebo reference="front_caster">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <link name="rear_caster">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.16 0 -0.115"/>
  </joint>

  <gazebo reference="rear_caster">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ===================== Frames de sensores ===================== -->
  <link name="laser_frame"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.1 0 0.13"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ===================== Sensores Gazebo (siempre activos) ===================== -->
  <gazebo reference="base_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0.1 0 0.13 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <ignition_frame_id>laser_frame</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <ignition_frame_id>imu_link</ignition_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================== Bloques condicionales ===================== -->
  <xacro:include filename="$(find dif_bot)/urdf/gz_control.xacro"/>
  <xacro:include filename="$(find dif_bot)/urdf/ros2_control.xacro"/>

</robot>
