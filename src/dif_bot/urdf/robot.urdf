<robot name="dif_bot"><link name="base_link"><inertial><mass value="5"/><inertia ixx="0.06" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.12"/></inertial><visual><geometry><box size="0.4 0.3 0.15"/></geometry></visual><collision><geometry><box size="0.4 0.3 0.15"/></geometry></collision></link><link name="left_wheel"><inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.001"/></inertial><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></visual><collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision></link><joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.19 -0.05"/><axis xyz="0 1 0"/></joint><link name="right_wheel"><inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.001"/></inertial><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></visual><collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision></link><joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.19 -0.05"/><axis xyz="0 1 0"/></joint><link name="front_caster"><inertial><mass value="0.05"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial><visual><geometry><sphere radius="0.035"/></geometry></visual><collision><geometry><sphere radius="0.035"/></geometry></collision></link><joint name="front_joint" type="fixed"><parent link="base_link"/><child link="front_caster"/><origin xyz="0.16 0 -0.115"/></joint><gazebo reference="front_caster"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo><link name="rear_caster"><inertial><mass value="0.05"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial><visual><geometry><sphere radius="0.035"/></geometry></visual><collision><geometry><sphere radius="0.035"/></geometry></collision></link><joint name="rear_joint" type="fixed"><parent link="base_link"/><child link="rear_caster"/><origin xyz="-0.16 0 -0.115"/></joint><gazebo reference="rear_caster"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo><link name="laser_frame"/><joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0.1 0 0.13"/></joint><link name="imu_link"/><joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/></joint><gazebo reference="base_link"><sensor name="lidar" type="gpu_lidar"><pose>0.1 0 0.13 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on><ignition_frame_id>laser_frame</ignition_frame_id><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></lidar></sensor><sensor name="imu" type="imu"><topic>/imu</topic><update_rate>50</update_rate><always_on>true</always_on><ignition_frame_id>imu_link</ignition_frame_id></sensor></gazebo><gazebo><plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.38</wheel_separation><wheel_radius>0.1</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency></plugin><plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"><topic>/joint_states</topic></plugin></gazebo></robot>