<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Activo solo sin ros2_control: DiffDrive nativo de Gazebo + publicador de joint states de Gazebo.
       Parametros del robot de persona-b: separacion 0.38, radio 0.1, odometria a 30 Hz. -->
  <xacro:unless value="$(arg use_ros2_control)">
    <gazebo>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.38</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <!-- Sin EKF: el TF odom->base_link sale por /tf (se bridgea).
             Con EKF: el TF lo publica ekf_filter_node; este plugin lo manda a un topic
             que NO se bridgea, asi no hay dos publicadores de odom->base_link. -->
        <xacro:if value="$(arg use_ekf)">
          <tf_topic>/tf_ekf_disabled</tf_topic>
        </xacro:if>
        <xacro:unless value="$(arg use_ekf)">
          <tf_topic>/tf</tf_topic>
        </xacro:unless>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
        <topic>/joint_states</topic>
      </plugin>
    </gazebo>
  </xacro:unless>

</robot>
