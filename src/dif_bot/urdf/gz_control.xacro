<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Activo solo sin ros2_control: DiffDrive nativo de Gazebo + publicador de joint states de Gazebo -->
  <xacro:unless value="$(arg use_ros2_control)">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.3</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <!-- Sin EKF: el TF odom->base_link sale por /tf (se bridgea).
             Con EKF: el TF lo publica ekf_filter_node; este plugin lo manda a un topic gz
             que NO se bridgea, asi no hay dos publicadores de odom->base_link. -->
        <xacro:if value="$(arg use_ekf)">
          <tf_topic>/model/dif_bot/tf_ekf_disabled</tf_topic>
        </xacro:if>
        <xacro:unless value="$(arg use_ekf)">
          <tf_topic>/tf</tf_topic>
        </xacro:unless>
        <odom_publisher_frequency>50</odom_publisher_frequency>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:unless>

</robot>
