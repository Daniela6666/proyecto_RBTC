<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Activo solo con ros2_control: hardware ign_ros2_control y plugin de sistema en Gazebo -->
  <xacro:if value="$(arg use_ros2_control)">
    <ros2_control name="IgnitionSystem" type="system">
      <hardware>
        <plugin>ign_ros2_control/IgnitionSystem</plugin>
      </hardware>
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <!-- Con EKF: controllers_ekf.yaml (enable_odom_tf false); sin EKF: controllers.yaml (sin cambios) -->
        <xacro:if value="$(arg use_ekf)">
          <parameters>$(find dif_bot)/config/controllers_ekf.yaml</parameters>
        </xacro:if>
        <xacro:unless value="$(arg use_ekf)">
          <parameters>$(find dif_bot)/config/controllers.yaml</parameters>
        </xacro:unless>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
